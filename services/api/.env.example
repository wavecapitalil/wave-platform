# Optional AI providers
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Browser origins allowed to call /api/* during development.
WAVE_ALLOWED_ORIGINS=http://localhost:5001,http://127.0.0.1:5001

# Portable Morning Brief storage.
# Mount or persist this directory in production.
WAVE_BRIEF_DIR=services/api/data/briefs

# Persistent application data (SQLite caches, article archive/images).
WAVE_DATA_DIR=services/api/data

# Background workers (Morning Brief refresh + content curator).
# Set to 0 for tests or deployments that run schedulers separately.
WAVE_START_BACKGROUND=1
